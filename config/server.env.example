# Local test config (Linux). Docs: docs/CONFIGURATION.md
PUBLIC_HOST=192.168.1.10
PUBLIC_IP=192.168.1.10
BASE_DOMAIN=nfsrun.test
AUTH_MODE=open
DS_ENABLED=false

# Race servers through Proton (Linux test)
DS_ENABLED=true
DS_GAME_DIR=/path/to/repo/runtime/nfstr_host
DS_LAUNCHER=/path/to/repo/tools-linux/ds_launch.sh
DS_KEEP_HOSTS=true
DS_COUNT=2
DS_PUBLIC_IP=192.168.1.10

# Admin web page (open http://<this PC>:8090 from the LAN)
ADMIN_WEB_LISTEN=0.0.0.0:8090
ADMIN_WEB_USER=admin
ADMIN_WEB_PASSWORD=change-me
