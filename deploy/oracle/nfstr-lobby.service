[Unit]
Description=NFSTR lobby
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/nfstr/lobby_server.py --bind 0.0.0.0 --port 26100 --data /var/lib/nfstr/lobby_data.json
StateDirectory=nfstr
Restart=always
RestartSec=3
User=nfstr
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
