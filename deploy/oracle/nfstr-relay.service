[Unit]
Description=NFSTR UDP relay
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/nfstr/relay.py --bind 0.0.0.0 --control-port 26000 --room-ports 26001-26100
Restart=always
RestartSec=3
User=nfstr
DynamicUser=no
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
